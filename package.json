{
  "name": "issue-tracker-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:design": "node scripts/lint-design.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run db:test:prepare && playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:prepare": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "16.3.5",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.1.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "dotenv-cli": "10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.1"
  }
}
